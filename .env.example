SPOTIFY_CLIENT_ID=cole_seu_client_id_aqui
SPOTIFY_REDIRECT_URI=http://localhost:3000/spotify/callback
# Segredo de pelo menos 32 caracteres; mantenha o MESMO valor no Render entre deploys
# Usado para criptografar a autorizacao Spotify no cookie de cada navegador
SPOTIFY_SESSION_SECRET=

# Cadastro verificado: configure um dominio remetente no Resend
RESEND_API_KEY=
VERIFY_EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# Junto.fm TV (somente servidor: configure no Render, nunca no navegador)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
